# Configuración docente de PRJNA1347747. Este archivo se carga con source.
PROJECT_ID="PRJNA1347747"
EXPERIMENT_ID="ethylene_rootstocks_salt"
EXPERIMENT_NAME="Etileno del portainjerto y salinidad (PRJNA1347747)"

# Cambiar según el equipo. Con poca experiencia, empezar con 4 u 8.
THREADS=8

# Los datos grandes quedan fuera del repositorio.
WORK_DIR="${HOME}/peipers-rnaseq-work/PRJNA1347747"

# Los FASTQ comprimidos ocupan aproximadamente 100 GB.
MIN_FREE_GB=130
RUN_FASTQC=1

# Referencia y cuantificador exactos del TPM-consultor actual.
REFERENCE_RELEASE="ITAG4.0"
SALMON_VERSION_REQUIRED="2.0.1"
SALMON_K=31
